# Database
DATABASE_URL=postgresql://<username>:<password>@localhost:5434/civic_complaints

# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# External Services & Email Notifications
EMAIL_SERVICE_API_KEY=
SMS_SERVICE_API_KEY=
PUSH_SERVICE_API_KEY=
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=JanSewa Civic Support <support@jansewa.gov>
SMTP_USE_TLS=true

# LLM Prioritization Engine (Groq / OpenAI)
# To use Groq, add your API key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# (Optional fallback) OpenAI configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TARGET_VOTES=50

# Priority Engine Weights (must sum to 1.0)
PRIORITY_WEIGHT_SEVERITY=0.40
PRIORITY_WEIGHT_IMPACT=0.25
PRIORITY_WEIGHT_URGENCY=0.20
PRIORITY_WEIGHT_SUPPORT=0.15

# Priority Thresholds
PRIORITY_HIGH_THRESHOLD=0.7
PRIORITY_MEDIUM_THRESHOLD=0.4

# Ageing
MAX_AGE_DAYS=30
AGEING_CURVE=linear

# Location Sensitivity
SENSITIVE_ZONE_RADIUS_KM=2.0
HIGH_FOOTFALL_RADIUS_KM=1.0

# Vote Saturation
VOTE_SATURATION=50

# App
ENVIRONMENT=development
DEBUG=true
SQL_ECHO=false

# Live scanner: URL of the separately running ai_service
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=45
