# ===========================================
# Docker Compose Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# PostgreSQL Credentials
POSTGRES_DB=civic_complaints
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5434

# Security
SECRET_KEY=

# Roboflow hosted inference (serverless)
# Get a key at https://app.roboflow.com/settings/api - keep it server-side only
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=potholes-scbcq/1
ROBOFLOW_GARBAGE_MODEL_ID=garbage-d6vgh/1
ROBOFLOW_API_URL=https://serverless.roboflow.com

# Backend -> ai_service proxy. Not reachable from inside a container.
AI_SERVICE_URL=http://127.0.0.1:8001
