# ===========================================
# Docker Compose Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# PostgreSQL Credentials
POSTGRES_DB=civic_complaints
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5434

# Security
SECRET_KEY=

# Roboflow hosted inference (serverless)
# Get a key at https://app.roboflow.com/settings/api - keep it server-side only
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=potholes-scbcq/1
ROBOFLOW_GARBAGE_MODEL_ID=garbage-d6vgh/1
# Context models: people and vehicles are drawn but never auto-filed.
ROBOFLOW_HUMAN_MODEL_ID=humans-v0nq1/1
ROBOFLOW_CAR_MODEL_ID=cars-blxk2/2
# Extra pothole opinions merged with ROBOFLOW_MODEL_ID.
ROBOFLOW_POTHOLE_KW_MODEL_ID=kuwait-potholes/1
ROBOFLOW_POTHOLE_ALT_MODEL_ID=potholes-detection-j3w8s/1
# Models /detect/scan fans out to. Each is one billed hosted call per frame;
# trim this list to cut spend.
ROBOFLOW_SCAN_KINDS=road,garbage,human,car,pothole_kw,pothole_alt
ROBOFLOW_API_URL=https://serverless.roboflow.com

# For manual backend runs. Docker Compose sets the backend URL to http://ai-service:8001.
AI_SERVICE_URL=http://127.0.0.1:8001
